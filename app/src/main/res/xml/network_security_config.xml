<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Pairing talks HTTP to a LAN IP; the session itself is ECDH+AES-GCM. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
